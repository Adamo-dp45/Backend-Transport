# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# !! TRANSPORT NUL EN TEST. Sans cette ligne, tout test qui déclenche un envoi de courriel tente
# une connexion SMTP réelle vers 'localhost:1025' (Mailpit) et répond 500 si rien n'écoute : la
# suite dépendait alors d'un service lancé à la main, et l'échec ne désignait pas la bonne cause.
# Les tests qui VÉRIFIENT un envoi passent par le collecteur de messages de Symfony, pas par SMTP.
MAILER_DSN=null://null
